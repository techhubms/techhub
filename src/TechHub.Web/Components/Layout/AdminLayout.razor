@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <PageTitle>Admin — TechHub</PageTitle>

        @{
            var (activeGroup, activeItem) = FindActive();
        }

        <nav class="admin-nav" aria-label="Admin navigation">
            <div class="admin-nav-content">
                <a href="/admin" class="admin-brand">
                    <span class="admin-brand-text">Tech Hub</span>
                    <span class="admin-brand-badge">Admin</span>
                </a>

                <div class="admin-nav-links">
                    @foreach (var group in AdminNavigation.Groups)
                    {
                        var isActive = ReferenceEquals(group, activeGroup);
                        <a href="@group.Href" class="admin-nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">@group.Label</a>
                    }
                </div>
                <div class="admin-nav-actions">
                    <form method="post" action="/admin/logout" class="admin-logout-form">
                        <AntiforgeryToken />
                        <button type="submit" class="admin-logout-btn">Log out</button>
                    </form>
                </div>
            </div>
        </nav>

        @if (activeGroup is not null)
        {
            <nav class="admin-subnav" aria-label="@activeGroup.Label">
                <div class="admin-subnav-content">
                    <div class="admin-subnav-links">
                        @foreach (var item in activeGroup.Items)
                        {
                            var isActive = ReferenceEquals(item, activeItem);
                            <a href="@item.Href" class="admin-subnav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">@item.Label</a>
                        }
                    </div>
                    <div class="admin-subnav-actions">
                        <SectionOutlet SectionName="@AdminSubbarAction.SectionName" />
                    </div>
                </div>
            </nav>
        }

        <main class="admin-main">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    <CascadingValue Name="@AdminSubbarAction.HostName" Value="true" IsFixed="true">
                        @Body
                    </CascadingValue>
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="admin-alert admin-alert-error" role="alert">
                        An unexpected error occurred. Please try refreshing the page.
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </Authorized>
    <NotAuthorized>
        <main class="admin-main">
            <TechHub.Web.Components.Pages.Admin.AdminLoginContent />
        </main>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        // Clear error boundary when navigating between admin pages
        _errorBoundary?.Recover();
    }

    private (AdminNavGroup? Group, AdminNavItem? Item) FindActive()
    {
        var path = AdminNavigation.NormalizePath(Navigation.ToBaseRelativePath(Navigation.Uri));
        var group = AdminNavigation.FindGroup(path);
        return (group, group?.FindItem(path));
    }
}