@page "/{SectionName}/timeline"
@using System.Globalization
@using System.Security.Cryptography
@using System.Text.Json
@using TechHub.Core.Models
@using TechHub.Core.Models.ContentProcessing
@using TechHub.Core.Models.FeatureToggles
@using TechHub.Web.Services
@implements IDisposable
@inherits PageComponentBase

@inject ITechHubApiClient ApiClient
@inject IFeatureGate FeatureGate
@inject SectionCache SectionCache
@inject NavigationManager Navigation
@inject ErrorService ErrorService
@inject ILogger<SectionTimeline> Logger
@inject PersistentComponentState ApplicationState

<PageTitle>@PageTitleText</PageTitle>

@if (sectionData is not null)
{
    <SeoMetaTags
        Title="@PageTitleText"
        Description="@SeoDescription"
        ContentType="SeoMetaTags.SeoContentType.Website" />

    <main class="page-with-sidebar" data-in-place-query>
        <aside class="sidebar">
            <SidebarToggle />
            <MobileSidebarToolbar>
                <MobileSidebarPanel Label="Show" Icon="filter" HasActiveFilter="@(_activeKinds is not null || _futureWindow != FutureWindow.Upcoming)">
                    <nav class="sidebar-section" aria-label="Kinds of dates">
                        <h2 class="sidebar-h2">Show</h2>
                        <div class="timeline-filter">
                            @foreach (var filter in Filters)
                            {
                                var isActive = filter.Value == _activeKinds;
                                <a href="@BuildHref(filter.Value, _showAll, _futureWindow)"
                                   class="timeline-filter-link @(isActive ? "active" : "")"
                                   aria-current="@(isActive ? "true" : null)">@filter.Label</a>
                            }
                        </div>
                    </nav>
                    <nav class="sidebar-section" aria-label="Future events">
                        <h2 class="sidebar-h2">Future events</h2>
                        <div class="timeline-filter">
                            <a href="@BuildHref(_activeKinds, _showAll, FutureWindow.Upcoming)"
                               class="timeline-filter-link @(_futureWindow == FutureWindow.Upcoming ? "active" : "")"
                               aria-current="@(_futureWindow == FutureWindow.Upcoming ? "true" : null)">Next 6 months</a>
                            <a href="@BuildHref(_activeKinds, _showAll, FutureWindow.All)"
                               class="timeline-filter-link @(_futureWindow == FutureWindow.All ? "active" : "")"
                               aria-current="@(_futureWindow == FutureWindow.All ? "true" : null)">All future events</a>
                            <a href="@BuildHref(_activeKinds, _showAll, FutureWindow.Hidden)"
                               class="timeline-filter-link @(_futureWindow == FutureWindow.Hidden ? "active" : "")"
                               aria-current="@(_futureWindow == FutureWindow.Hidden ? "true" : null)">Hide future events</a>
                        </div>
                        <p class="timeline-filter-help">Upcoming dates are shown through @Today().AddMonths(6).ToString("d MMM yyyy", CultureInfo.InvariantCulture) by default.</p>
                    </nav>
                </MobileSidebarPanel>
            </MobileSidebarToolbar>
        </aside>

        <article class="article-body" aria-busy="@(!IsPageDataReady ? "true" : "false")">
            <div class="content-detail-header">
                <h1 id="skiptohere" class="page-h1">Timeline</h1>
            </div>

            <div class="timeline-page-intro">
                <p>@SeoDescription</p>
            </div>

            <TimelineView @key="sectionData.Name"
                          Entries="_viewEntries"
                          Notice="_notice"
                          AriaLabel="@($"{sectionData.Title} timeline")"
                          EmptyText="No dates found for this selection.">
                <Detail Context="entry">
                    <ul class="timeline-sources" aria-label="Sources">
                        @foreach (var source in _entriesById[entry.Id].Sources)
                        {
                            var href = source.GetHref();
                            var isExternal = href.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                            <li>
                                <a href="@href"
                                   data-content-link
                                   target="@(isExternal ? "_blank" : null)"
                                   rel="@(isExternal ? "noopener noreferrer" : null)"
                                   @onclick:stopPropagation="true">@source.Title</a>
                            </li>
                        }
                    </ul>
                </Detail>
            </TimelineView>

            <p class="timeline-page-window">
                @if (_entries.Count >= MaxEntries)
                {
                    <span>Showing the newest @MaxEntries dates.</span>
                }
                @if (_showAll)
                {
                    <a href="@BuildHref(_activeKinds, false, _futureWindow)">Show only the last 12 months</a>
                }
                else
                {
                    <a href="@BuildHref(_activeKinds, true, _futureWindow)">Show earlier dates</a>
                }
            </p>
        </article>
    </main>
}
else
{
    <NotFoundContent />
}

@code {
    // The API returns at most this many entries, newest first.
    private const int MaxEntries = 200;

    private static readonly TimeZoneInfo BrusselsTz =
        TimeZoneInfo.TryFindSystemTimeZoneById("Europe/Brussels", out var tz) ? tz : TimeZoneInfo.Utc;

    private static readonly IReadOnlyList<KindFilter> Filters =
    [
        new("All", null),
        new("Releases", "announced,preview,ga,launch,release"),
        new("Deprecations", "deprecation,retirement,end-of-support,breaking-change"),
        new("Other", "pricing-change,event")
    ];

    private static readonly Dictionary<string, (string Label, string CssClass)> KindBadges = new(StringComparer.Ordinal)
    {
        ["announced"] = ("Announced", "badge-info"),
        ["preview"] = ("Preview", "badge-info"),
        ["ga"] = ("GA", "badge-success"),
        ["launch"] = ("Launch", "badge-success"),
        ["release"] = ("Release", "badge-success"),
        ["deprecation"] = ("Deprecation", "badge-warning"),
        ["retirement"] = ("Retirement", "badge-warning"),
        ["end-of-support"] = ("End of support", "badge-warning"),
        ["breaking-change"] = ("Breaking change", "badge-warning"),
        ["pricing-change"] = ("Pricing change", "badge-muted"),
        ["event"] = ("Event", "badge-muted")
    };

    private TechHub.Core.Models.Section? sectionData;
    private IReadOnlyList<TimelineEntry> _entries = [];
    private IReadOnlyList<TimelineViewEntry> _viewEntries = [];
    private Dictionary<string, TimelineEntry> _entriesById = new(StringComparer.Ordinal);
    private string? _activeKinds;
    private bool _showAll;
    private FutureWindow _futureWindow;
    private int _hiddenFutureCount;
    private TimelineViewNotice? _notice;
    private string? _requestedKey;
    private string? _loadedKey;
    private long _loadVersion;
    private bool _notFound;
    private PersistingComponentStateSubscription? _persistSubscription;

    [Parameter]
    public string SectionName { get; set; } = null!;

    /// <summary>Comma separated event kinds to show, for example <c>deprecation,retirement</c>.</summary>
    [SupplyParameterFromQuery(Name = "kinds")]
    public string? KindsParam { get; set; }

    /// <summary><c>all</c> includes earlier history; otherwise dates start twelve months ago. The future setting is independent.</summary>
    [SupplyParameterFromQuery(Name = "since")]
    public string? SinceParam { get; set; }

    /// <summary><c>show</c> includes all future events, <c>hide</c> excludes them; otherwise the next six months are included.</summary>
    [SupplyParameterFromQuery(Name = "future")]
    public string? FutureParam { get; set; }

    protected override bool IsNotFound => _notFound;

    protected override bool IsPageDataReady => _loadedKey == _requestedKey;

    private string PageTitleText => $"Timeline - {sectionData?.Title ?? SectionName} - Tech Hub";

    private string SeoDescription =>
        $"The dates that articles in {sectionData?.Title ?? SectionName} give: what moves to preview or general availability, and what is deprecated or retired. " +
        "The same date, stated by several articles, is shown once. Open a card to see where it comes from.";

    protected override void OnInitialized()
    {
        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistState);
    }

    protected override async Task OnParametersSetAsync()
    {
        // A feature that is off, or only on for admins, does not exist for this visitor
        var nextSection = await FeatureGate.IsEnabledAsync(FeatureKeys.Timeline)
            ? SectionCache.GetSectionByName(SectionName)
            : null;
        if (sectionData?.Name != nextSection?.Name)
        {
            _requestedKey = null;
            _loadedKey = null;
            _loadVersion++;
            SetEntries([], 0);
        }

        sectionData = nextSection;
        if (sectionData is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;
        _activeKinds = NormalizeKinds(KindsParam);
        _showAll = string.Equals(SinceParam, "all", StringComparison.OrdinalIgnoreCase);
        _futureWindow = FutureParam?.ToLowerInvariant() switch
        {
            "show" => FutureWindow.All,
            "hide" => FutureWindow.Hidden,
            _ => FutureWindow.Upcoming
        };

        var key = $"{sectionData.Name}|{_activeKinds}|{_showAll}|{_futureWindow}";
        if (key == _requestedKey)
        {
            return;
        }

        _requestedKey = key;
        var loadVersion = ++_loadVersion;
        if (key == _loadedKey)
        {
            return;
        }

        if (ApplicationState.TryTakeFromJson<PersistedTimeline>("section-timeline", out var restored)
            && restored is not null
            && restored.Key == key)
        {
            SetEntries(restored.Entries, restored.HiddenFutureCount);
            _loadedKey = key;
            return;
        }

        try
        {
            var today = Today();
            var from = _showAll ? (DateOnly?)null : today.AddMonths(-12);
            var kinds = _activeKinds?.Split(',');
            IReadOnlyList<TimelineEntry> entries;
            var hiddenCount = 0;
            if (_futureWindow == FutureWindow.All)
            {
                entries = await ApiClient.GetSectionTimelineAsync(sectionData.Name, from, null, kinds);
            }
            else
            {
                // Query hidden events separately so they cannot consume the API's limit for visible entries.
                var through = _futureWindow == FutureWindow.Hidden ? today : today.AddMonths(6);
                var visible = ApiClient.GetSectionTimelineAsync(sectionData.Name, from, through, kinds);
                var hidden = ApiClient.GetSectionTimelineAsync(sectionData.Name, through.AddDays(1), null, kinds);
                await Task.WhenAll(visible, hidden);
                entries = await visible;
                hiddenCount = (await hidden).Count;
            }

            if (loadVersion == _loadVersion)
            {
                SetEntries(entries, hiddenCount);
                _loadedKey = key;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            if (loadVersion == _loadVersion)
            {
                ErrorService.HandleError(ex, Navigation, Logger);
            }
            else
            {
                Logger.LogWarning(ex, "A superseded timeline request failed.");
            }
        }
    }

    private void SetEntries(IReadOnlyList<TimelineEntry> entries, int hiddenFutureCount)
    {
        _entries = entries;
        _hiddenFutureCount = hiddenFutureCount;
        _notice = BuildFutureNotice();
        _entriesById = new(StringComparer.Ordinal);
        var viewEntries = new List<TimelineViewEntry>(entries.Count);
        foreach (var entry in entries)
        {
            var (date, datePrecision, kind, productKey, featureKey) = TimelineEntry.GetGroupKey(
                entry.Date, entry.DatePrecision, entry.Kind, entry.ProductId, entry.Product, entry.FeatureId, entry.Feature);
            var fingerprint = Convert.ToHexString(SHA256.HashData(
                JsonSerializer.SerializeToUtf8Bytes(new { date, datePrecision, kind, productKey, featureKey })));
            var id = fingerprint;
            for (var duplicate = 1; !_entriesById.TryAdd(id, entry); duplicate++)
            {
                id = $"{fingerprint}-{duplicate.ToString(CultureInfo.InvariantCulture)}";
            }
            viewEntries.Add(ToViewEntry(id, entry));
        }
        _viewEntries = viewEntries;
    }

    private TimelineViewEntry ToViewEntry(string id, TimelineEntry entry)
    {
        var badges = new List<TimelineViewBadge> { new(entry.Product, "badge-tag") };
        var kind = KindBadges.TryGetValue(entry.Kind, out var known) ? known : (Label: entry.Kind, CssClass: "badge-muted");
        badges.Add(new TimelineViewBadge(kind.Label, kind.CssClass));
        if (entry.Date > Today())
        {
            badges.Add(new TimelineViewBadge("Upcoming", "badge-info"));
        }

        return new TimelineViewEntry
        {
            Id = id,
            Title = entry.Title ?? string.Empty,
            Date = entry.Date,
            DateLabel = FormatDate(entry),
            Description = entry.Description,
            Badges = badges
        };
    }

    /// <summary>The date as precisely as the article states it: a day, a month or a quarter.</summary>
    private static string FormatDate(TimelineEntry entry) => entry.DatePrecision switch
    {
        "quarter" => $"Q{(entry.Date.Month - 1) / 3 + 1} {entry.Date.Year}",
        "month" => entry.Date.ToString("MMM yyyy", CultureInfo.InvariantCulture),
        _ => entry.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
    };

    /// <summary>Keeps the valid kinds of the query string, in the order given, or <c>null</c> when none is valid.</summary>
    private static string? NormalizeKinds(string? kinds)
    {
        var valid = (kinds ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(TimelineEvent.ValidKinds.Contains)
            .Distinct(StringComparer.Ordinal)
            .ToList();
        return valid.Count == 0 ? null : string.Join(',', valid);
    }

    private static DateOnly Today() => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, BrusselsTz).DateTime);

    /// <summary>The heading and the link that stand where the hidden future events would be, or <c>null</c> when none are hidden.</summary>
    private TimelineViewNotice? BuildFutureNotice()
    {
        if (_hiddenFutureCount == 0)
        {
            return null;
        }

        // The API returns at most MaxEntries, so that many means there may be more
        var count = _hiddenFutureCount >= MaxEntries ? $"{MaxEntries}+" : _hiddenFutureCount.ToString(CultureInfo.InvariantCulture);
        var scope = _futureWindow == FutureWindow.Hidden ? "hidden" : "beyond the next 6 months";
        return new TimelineViewNotice("Future events", $"Show all future events ({count} {scope})", BuildHref(_activeKinds, _showAll, FutureWindow.All));
    }

    private string BuildHref(string? kinds, bool showAll, FutureWindow futureWindow)
    {
        var query = new List<string>();
        if (kinds is not null)
        {
            query.Add($"kinds={kinds}");
        }

        if (showAll)
        {
            query.Add("since=all");
        }

        if (futureWindow == FutureWindow.All)
        {
            query.Add("future=show");
        }
        else if (futureWindow == FutureWindow.Hidden)
        {
            query.Add("future=hide");
        }

        return $"/{SectionName}/timeline" + (query.Count > 0 ? "?" + string.Join('&', query) : string.Empty);
    }

    private Task PersistState()
    {
        ApplicationState.PersistAsJson("section-timeline", new PersistedTimeline { Key = _loadedKey ?? string.Empty, Entries = _entries, HiddenFutureCount = _hiddenFutureCount });
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _loadVersion++;
        _persistSubscription?.Dispose();
        GC.SuppressFinalize(this);
    }

    private sealed record KindFilter(string Label, string? Value);

    private enum FutureWindow
    {
        Upcoming,
        All,
        Hidden
    }

    private sealed class PersistedTimeline
    {
        public string Key { get; set; } = string.Empty;
        public IReadOnlyList<TimelineEntry> Entries { get; set; } = [];
        public int HiddenFutureCount { get; set; }
    }
}
