@page "/admin"
@layout AdminLayout
@rendermode InteractiveServer
@using TechHub.Core.Models.Admin
@using TechHub.Web.Services
@implements IDisposable
@inject ITechHubApiClient Api
@inject PersistentComponentState ApplicationState
@inject ILogger<AdminDashboard> Logger
@inject NavigationManager Navigation
@inherits PageComponentBase

<PageTitle>Admin Dashboard — TechHub</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Background Tasks</h1>
            <p class="admin-page-subtitle">Job history and live logs. Start processing and roundup generation from Settings, the content cleanup from Reviews.</p>
        </div>
        <div class="admin-actions">
            @if (HasRunningJob)
            {
                <button class="btn-danger" @onclick="CancelRunningJobAsync" disabled="@_cancelling">
                    @if (_cancelling)
                    {
                        <span>Cancelling…</span>
                    }
                    else
                    {
                        <span>⏹ Cancel Running</span>
                    }
                </button>
            }
            <AdminSubbarAction><button class="btn-secondary" @onclick="LoadJobsAsync">⟳ Refresh</button></AdminSubbarAction>
        </div>
    </div>

    @if (_triggerMessage != null)
    {
        <div class="admin-alert @(_triggerError ? "admin-alert-error" : "admin-alert-success")" role="alert">
            @_triggerMessage
        </div>
    }

    <div class="admin-filters">
        <div class="admin-filter-group">
            <label class="admin-label" for="jobStatusFilter">Status</label>
            <select id="jobStatusFilter" class="admin-input" @bind="_statusFilter" @bind:after="ApplyFilters">
                <option value="">All</option>
                <option value="@ContentProcessingJobStatus.Running">Running</option>
                <option value="@ContentProcessingJobStatus.Completed">Completed</option>
                <option value="@ContentProcessingJobStatus.Failed">Failed</option>
                <option value="@ContentProcessingJobStatus.Aborted">Aborted</option>
            </select>
        </div>
        <div class="admin-filter-group">
            <label class="admin-label" for="jobTypeFilter">Type</label>
            <select id="jobTypeFilter" class="admin-input" @bind="_jobTypeFilter" @bind:after="ApplyFilters">
                <option value="">All</option>
                @foreach (var jobType in JobTypes)
                {
                    <option value="@jobType">@JobTypeLabel(jobType)</option>
                }
            </select>
        </div>
        <div class="admin-filter-group">
            <label class="admin-label" for="jobTriggerFilter">Trigger</label>
            <select id="jobTriggerFilter" class="admin-input" @bind="_triggerFilter" @bind:after="ApplyFilters">
                <option value="">All</option>
                <option value="@ContentProcessingJobTrigger.Scheduled">Scheduled</option>
                <option value="@ContentProcessingJobTrigger.Manual">Manual</option>
            </select>
        </div>
        @if (CurrentFilter.IsActive)
        {
            <div class="admin-filter-group admin-filter-actions">
                <button class="btn-secondary" @onclick="ClearFilters">Clear filters</button>
            </div>
        }
    </div>

    @if (_loading)
    {
        <div class="admin-loading">Loading job history…</div>
    }
    else if (_error != null)
    {
        <div class="admin-alert admin-alert-error" role="alert">@_error</div>
    }
    else if (_jobs == null || _jobs.Count == 0)
    {
        @if (CurrentFilter.IsActive)
        {
            <div class="admin-empty">No jobs match the current filters.</div>
        }
        else
        {
            <div class="admin-empty">No processing jobs yet. Click <strong>Run Now</strong> to start the first run.</div>
        }
    }
    else
    {
        <div class="admin-jobs-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Started</th>
                        <th>Duration</th>
                        <th>Trigger</th>
                        <th>Status</th>
                        <th class="admin-cell-number">Added</th>
                        <th class="admin-cell-number">Skipped</th>
                        <th class="admin-cell-number">Errors</th>
                        <th class="admin-cell-number">Fixed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in _jobs)
                    {
                        <tr>
                            <td class="admin-cell-mono">@job.Id</td>
                            <td>
                                <span class="admin-badge admin-badge-@JobTypeBadge(job.JobType)">@JobTypeLabel(job.JobType)</span>
                            </td>
                            <td>@FormatTimestamp(job.StartedAt)</td>
                            <td>@FormatDuration(job.DurationMs, job.Status == ContentProcessingJobStatus.Running ? job.StartedAt : null)</td>
                            <td>
                                <span class="admin-badge admin-badge-@job.TriggerType">@job.TriggerType</span>
                            </td>
                            <td>
                                <span class="admin-status admin-status-@job.Status">
                                    @StatusIcon(job.Status) @job.Status
                                </span>
                            </td>
                            <td class="admin-cell-number">
                                @if (job.JobType == ContentProcessingJobType.ContentCleanup)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @job.ItemsAdded
                                }
                            </td>
                            <td class="admin-cell-number">
                                @if (job.JobType == ContentProcessingJobType.ContentCleanup)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @job.ItemsSkipped
                                }
                            </td>
                            <td class="admin-cell-number @(job.ErrorCount > 0 ? "admin-cell-error" : "")">
                                @job.ErrorCount
                            </td>
                            <td class="admin-cell-number">
                                @if (job.JobType is ContentProcessingJobType.ContentCleanup or ContentProcessingJobType.TimelineBackfill)
                                {
                                    @job.ItemsFixed
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                @if (job.JobType is not (ContentProcessingJobType.ContentCleanup or ContentProcessingJobType.TimelineBackfill))
                                {
                                    <a class="admin-link-btn" href="@($"/admin/processed-urls?jobId={job.Id}")"
                                       title="Show URLs processed by this job">View Processed</a>
                                }
                                @if (_expandedJobId == job.Id)
                                {
                                    <button class="admin-link-btn" @onclick="() => CollapseLog()">Hide log</button>
                                }
                                else
                                {
                                    <button class="admin-link-btn" @onclick="() => ExpandLog(job.Id)">View log</button>
                                }
                            </td>
                        </tr>
                        @if (_expandedJobId == job.Id && _expandedLogOutput != null)
                        {
                            <tr class="admin-log-row">
                                <td colspan="11">
                                    <pre class="admin-log">@_expandedLogOutput</pre>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _cancelling;
    private string? _error;
    private string? _triggerMessage;
    private bool _triggerError;
    private IReadOnlyList<ContentProcessingJob>? _jobs;
    private bool _hasRunningJob;
    private string _statusFilter = string.Empty;
    private string _jobTypeFilter = string.Empty;
    private string _triggerFilter = string.Empty;
    private ContentProcessingJobFilter? _loadedFilter;
    private long? _expandedJobId;
    private string? _expandedLogOutput;
    private PersistingComponentStateSubscription? _persistSubscription;
    private CancellationTokenSource? _pollCts;
    private CancellationTokenSource? _loadCts;
    private int _requestVersion;

    private const int DefaultJobCount = 20;
    private const int FilteredJobCount = 100;
    private const string JobsStateKey = "admin-dashboard-jobs";
    private const string HasRunningJobStateKey = "admin-dashboard-has-running-job";

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? JobTypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "trigger")]
    public string? TriggerQuery { get; set; }

    private static readonly string[] JobTypes =
    [
        ContentProcessingJobType.ContentProcessing,
        ContentProcessingJobType.RoundupGeneration,
        ContentProcessingJobType.ContentCleanup,
        ContentProcessingJobType.AdHocProcessing,
        ContentProcessingJobType.TimelineBackfill
    ];

    private ContentProcessingJobFilter CurrentFilter => new(
        string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter,
        string.IsNullOrEmpty(_jobTypeFilter) ? null : _jobTypeFilter,
        string.IsNullOrEmpty(_triggerFilter) ? null : _triggerFilter);

    protected override void OnInitialized()
    {
        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistState);
    }

    /// <summary>
    /// Runs on every navigation to this page, so a link or a back/forward navigation that changes the
    /// query string also updates the filter controls and the results.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        _statusFilter = StatusQuery ?? string.Empty;
        _jobTypeFilter = JobTypeQuery ?? string.Empty;
        _triggerFilter = TriggerQuery ?? string.Empty;

        var filter = CurrentFilter;
        if (filter == _loadedFilter)
        {
            return;
        }

        var isFirstLoad = _loadedFilter is null;
        _loadedFilter = filter;

        if (isFirstLoad && TryRestorePrerenderedState())
        {
            StartPollingIfRunning();
            return;
        }

        CollapseLog();
        await LoadJobsAsync();
    }

    /// <summary>
    /// Restores the jobs and running flag loaded during prerendering, so hydration makes no API calls.
    /// </summary>
    private bool TryRestorePrerenderedState()
    {
        if (!ApplicationState.TryTakeFromJson<IReadOnlyList<ContentProcessingJob>>(JobsStateKey, out var restored) || restored == null ||
            !ApplicationState.TryTakeFromJson<bool>(HasRunningJobStateKey, out var hasRunningJob))
        {
            return false;
        }

        _jobs = restored;
        _hasRunningJob = hasRunningJob;
        _loading = false;
        return true;
    }

    private Task PersistState()
    {
        if (_jobs != null)
        {
            ApplicationState.PersistAsJson(JobsStateKey, _jobs);
            ApplicationState.PersistAsJson(HasRunningJobStateKey, _hasRunningJob);
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _persistSubscription?.Dispose();
        CancelPendingLoad();
        StopPolling();
    }

    private async Task LoadJobsAsync()
    {
        CancelPendingLoad();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        var requestVersion = ++_requestVersion;

        _loading = true;
        _error = null;

        try
        {
            var (jobs, hasRunningJob) = await FetchJobsAsync(ct);
            if (requestVersion != _requestVersion)
            {
                return;
            }

            _jobs = jobs;
            _hasRunningJob = hasRunningJob;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // A newer load superseded this one, or the page was closed
            return;
        }
        catch (HttpRequestException ex)
        {
            if (requestVersion != _requestVersion)
            {
                return;
            }

            _error = $"Failed to load jobs: {ex.Message}";
        }
        finally
        {
            if (requestVersion == _requestVersion)
            {
                _loading = false;
            }
        }

        StartPollingIfRunning();
    }

    private void CancelPendingLoad()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    /// <summary>
    /// Loads the jobs matching the current filters. A filter can hide the running job, while Cancel and
    /// live polling must keep working, so filtered views also ask whether any job is running. That
    /// request goes first: a job that finishes in between is then already in the history, or the
    /// running flag keeps polling going for another round.
    /// </summary>
    private async Task<(IReadOnlyList<ContentProcessingJob> Jobs, bool HasRunningJob)> FetchJobsAsync(CancellationToken ct)
    {
        var filter = CurrentFilter;
        if (!filter.IsActive)
        {
            var jobs = await Api.GetProcessingJobsAsync(DefaultJobCount, filter, ct);
            return (jobs, HasRunningJobIn(jobs));
        }

        var running = await Api.GetProcessingJobsAsync(1, new ContentProcessingJobFilter(Status: ContentProcessingJobStatus.Running), ct);
        var filtered = await Api.GetProcessingJobsAsync(FilteredJobCount, filter, ct);
        return (filtered, running.Count > 0 || HasRunningJobIn(filtered));
    }

    /// <summary>
    /// Puts the filters in the query string. The navigation runs <see cref="OnParametersSetAsync"/>, which loads the jobs.
    /// </summary>
    private void ApplyFilters()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["status"] = string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter,
            ["type"] = string.IsNullOrEmpty(_jobTypeFilter) ? null : _jobTypeFilter,
            ["trigger"] = string.IsNullOrEmpty(_triggerFilter) ? null : _triggerFilter
        });
        Navigation.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private void ClearFilters()
    {
        _statusFilter = string.Empty;
        _jobTypeFilter = string.Empty;
        _triggerFilter = string.Empty;
        ApplyFilters();
    }

    private async Task CancelRunningJobAsync()
    {
        _cancelling = true;
        _triggerMessage = null;

        try
        {
            await Api.CancelRunningJobAsync();
            _triggerMessage = "Cancellation requested — job will stop shortly.";
            _triggerError = false;

            await Task.Delay(1000);
            await LoadJobsAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (HttpRequestException ex)
        {
            _triggerMessage = $"Failed to cancel job: {ex.Message}";
            _triggerError = true;
        }
        finally
        {
            _cancelling = false;
        }
    }

    private async Task ExpandLog(long jobId)
    {
        _expandedJobId = jobId;
        _expandedLogOutput = null;

        try
        {
            var job = await Api.GetProcessingJobByIdAsync(jobId);
            _expandedLogOutput = job?.LogOutput ?? "(no log output)";
        }
        catch (HttpRequestException ex)
        {
            _expandedLogOutput = $"Failed to load log: {ex.Message}";
        }
    }

    private void CollapseLog()
    {
        _expandedJobId = null;
        _expandedLogOutput = null;
    }

    private static string FormatTimestamp(DateTimeOffset timestamp) =>
        DateHelper.FormatTimestamp(timestamp);

    private static string FormatDuration(long? durationMs, DateTimeOffset? runningStartedAt = null)
    {
        TimeSpan ts;
        if (runningStartedAt != null)
        {
            ts = DateTimeOffset.UtcNow - runningStartedAt.Value;
        }
        else if (durationMs != null)
        {
            ts = TimeSpan.FromMilliseconds(durationMs.Value);
        }
        else
        {
            return "—";
        }

        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}m {ts.Seconds}s"
            : $"{ts.TotalSeconds:F1}s";
    }

    private static string StatusIcon(string status) => status switch
    {
        ContentProcessingJobStatus.Running => "⏳",
        ContentProcessingJobStatus.Completed => "✅",
        ContentProcessingJobStatus.Failed => "❌",
        ContentProcessingJobStatus.Aborted => "⛔",
        _ => "❓"
    };

    private static string JobTypeLabel(string jobType) => jobType switch
    {
        ContentProcessingJobType.ContentProcessing => "Processing",
        ContentProcessingJobType.RoundupGeneration => "Roundup",
        ContentProcessingJobType.ContentCleanup => "Cleanup",
        ContentProcessingJobType.AdHocProcessing => "Ad-hoc",
        ContentProcessingJobType.TimelineBackfill => "Timeline",
        _ => jobType
    };

    private static string JobTypeBadge(string jobType) => jobType switch
    {
        ContentProcessingJobType.ContentProcessing => "processing",
        ContentProcessingJobType.RoundupGeneration => "roundup",
        ContentProcessingJobType.ContentCleanup => "cleanup",
        ContentProcessingJobType.AdHocProcessing => "adhoc",
        ContentProcessingJobType.TimelineBackfill => "timeline",
        _ => "unknown"
    };

    private bool HasRunningJob => _hasRunningJob;

    private static bool HasRunningJobIn(IReadOnlyList<ContentProcessingJob>? jobs) =>
        jobs?.Any(j => j.Status == ContentProcessingJobStatus.Running) == true;

    private void StartPollingIfRunning()
    {
        if (!HasRunningJob || _pollCts != null)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

            while (await timer.WaitForNextTickAsync(ct))
            {
                // A foreground load is in flight; it commits the results and keeps polling going
                if (_loading)
                {
                    continue;
                }

                try
                {
                    var requestVersion = ++_requestVersion;
                    var (jobs, hasRunningJob) = await FetchJobsAsync(ct);
                    if (requestVersion != _requestVersion)
                    {
                        continue;
                    }

                    _jobs = jobs;
                    _hasRunningJob = hasRunningJob;

                    // Auto-refresh the expanded log if viewing a running job
                    if (_expandedJobId != null)
                    {
                        var expandedJob = _jobs?.FirstOrDefault(j => j.Id == _expandedJobId);
                        if (expandedJob?.Status == ContentProcessingJobStatus.Running)
                        {
                            var job = await Api.GetProcessingJobByIdAsync(_expandedJobId.Value, ct);
                            _expandedLogOutput = job?.LogOutput ?? _expandedLogOutput;
                        }
                    }

                    await InvokeAsync(StateHasChanged);

                    if (!HasRunningJob)
                    {
                        break;
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Polling for job updates failed, will retry");
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose
        }
        finally
        {
            StopPolling();
        }
    }
}
