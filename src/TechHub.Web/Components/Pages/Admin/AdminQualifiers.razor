@page "/admin/products/qualifiers"
@layout AdminLayout
@rendermode InteractiveServer
@using TechHub.Core.Models.Admin
@using TechHub.Web.Services
@implements IDisposable
@inject ITechHubApiClient Api
@inject PersistentComponentState ApplicationState
@inherits PageComponentBase

<PageTitle>Plans and surfaces — TechHub Admin</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Plans and surfaces</h1>
            <p class="admin-page-subtitle">A product like GitHub Copilot is available in plans (Free, Pro, Business, Enterprise) and on surfaces (VS Code, JetBrains, github.com). They are not products of their own: events and product aliases carry them.</p>
        </div>
        <div class="admin-actions">
            <a href="/admin/products" class="btn-secondary">← Products</a>
            <AdminSubbarAction><button class="btn-secondary" @onclick="LoadAsync">⟳ Refresh</button></AdminSubbarAction>
        </div>
    </div>

    @if (_message != null)
    {
        <div class="admin-alert @(_messageIsError ? "admin-alert-error" : "admin-alert-success")" role="alert">
            @_message
        </div>
    }

    @if (_loading)
    {
        <div class="admin-loading">Loading plans and surfaces…</div>
    }
    else if (_error != null)
    {
        <div class="admin-alert admin-alert-error" role="alert">@_error</div>
    }
    else
    {
        <h2 class="admin-section-title">To review (@(_unmatched?.Count ?? 0))</h2>
        <p class="admin-result-summary">Plans and surfaces the AI returned that are not in the list below yet. Add one, or add it as an alias of an existing plan or surface.</p>

        @if (_unmatched == null || _unmatched.Count == 0)
        {
            <div class="admin-empty" id="unmatched-empty">Nothing to review.</div>
        }
        else
        {
            <div class="admin-jobs-table-wrapper">
                <table class="admin-table" id="unmatched-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Kind</th>
                            <th>Dates</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var name in _unmatched)
                        {
                            <tr>
                                <td>@name.Name</td>
                                <td>@name.Kind</td>
                                <td class="admin-cell-mono">@name.EventCount</td>
                                <td>
                                    <div class="admin-inline-form">
                                        <button class="admin-link-btn" disabled="@_busy" @onclick="() => AddAsync(name.Kind, name.Name)">Add as @name.Kind</button>
                                        <input class="admin-input" list="names-@name.Kind" placeholder="Alias of…" aria-label="Alias of @name.Kind for @name.Name"
                                               value="@GetAliasTarget(name)" @onchange="e => SetAliasTarget(name, e.Value?.ToString())" />
                                        <button class="admin-link-btn" disabled="@(_busy || string.IsNullOrWhiteSpace(GetAliasTarget(name)))" @onclick="() => AddAsAliasAsync(name)">Add as alias</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @foreach (var kind in Kinds)
        {
            <datalist id="names-@kind">
                @foreach (var qualifier in _qualifiers.Where(q => q.Kind == kind))
                {
                    <option value="@qualifier.Name"></option>
                }
            </datalist>
        }

        <h2 class="admin-section-title">Add a plan or surface</h2>

        <div class="admin-inline-form">
            <label class="admin-label" for="newKind">Kind</label>
            <select id="newKind" class="admin-input" @bind="_newKind">
                @foreach (var kind in Kinds)
                {
                    <option value="@kind">@kind</option>
                }
            </select>
            <label class="admin-label" for="newName">Name</label>
            <input id="newName" class="admin-input" @bind="_newName" placeholder="e.g. Business or JetBrains IDEs" />
            <button class="btn-secondary" disabled="@_busy" @onclick="CreateAsync">Add</button>
        </div>

        @foreach (var kind in Kinds)
        {
            <h2 class="admin-section-title">@(kind == QualifierKinds.Plan ? "Plans" : "Surfaces") (@_qualifiers.Count(q => q.Kind == kind))</h2>

            @foreach (var qualifier in _qualifiers.Where(q => q.Kind == kind))
            {
                <details class="admin-details" id="qualifier-@qualifier.Id">
                    <summary>
                        @qualifier.Name
                        <span class="admin-cell-mono"> — @qualifier.EventCount dates, @qualifier.ItemCount articles</span>
                        @if (qualifier.Aliases.Count > 0)
                        {
                            <span> (@string.Join(", ", qualifier.Aliases.Select(a => a.Alias)))</span>
                        }
                    </summary>

                    <div class="admin-inline-form">
                        <label class="admin-label" for="rename-@qualifier.Id">Name</label>
                        <input id="rename-@qualifier.Id" class="admin-input" value="@GetRename(qualifier)" @onchange="e => SetRename(qualifier, e.Value?.ToString())" />
                        <button class="btn-secondary" disabled="@_busy" @onclick="() => RenameAsync(qualifier)">Rename</button>
                    </div>

                    @if (qualifier.Aliases.Count > 0)
                    {
                        <ul class="admin-plain-list">
                            @foreach (var alias in qualifier.Aliases)
                            {
                                <li>
                                    @alias.Alias
                                    <button class="admin-link-btn admin-link-btn-danger" disabled="@_busy" @onclick="() => RemoveAliasAsync(qualifier, alias)">Remove</button>
                                </li>
                            }
                        </ul>
                    }

                    <div class="admin-inline-form">
                        <label class="admin-label" for="alias-@qualifier.Id">Add alias</label>
                        <input id="alias-@qualifier.Id" class="admin-input" value="@GetNewAlias(qualifier)" @onchange="e => SetNewAlias(qualifier, e.Value?.ToString())" placeholder="Another name" />
                        <button class="btn-secondary" disabled="@_busy" @onclick="() => AddAliasAsync(qualifier)">Add alias</button>
                    </div>

                    <div class="admin-inline-form">
                        @if (_pendingDelete == qualifier.Id)
                        {
                            <span class="admin-alert admin-alert-error" role="alert">
                                Delete '@qualifier.Name'? Dates and product aliases lose it.
                                <button class="btn" disabled="@_busy" @onclick="() => DeleteAsync(qualifier)">Confirm delete</button>
                                <button class="btn-secondary" @onclick="() => _pendingDelete = null">Cancel</button>
                            </span>
                        }
                        else
                        {
                            <button class="btn-secondary" disabled="@_busy" @onclick="() => _pendingDelete = qualifier.Id">Delete…</button>
                        }
                    </div>
                </details>
            }
        }
    }
</div>

@code {
    private static readonly string[] Kinds = [QualifierKinds.Plan, QualifierKinds.Surface];

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private bool _messageIsError;
    private string _newKind = QualifierKinds.Plan;
    private string _newName = string.Empty;
    private long? _pendingDelete;
    private IReadOnlyList<ProductQualifier> _qualifiers = [];
    private IReadOnlyList<UnmatchedQualifierName>? _unmatched;
    private readonly Dictionary<string, string> _aliasTargets = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<long, string> _renames = [];
    private readonly Dictionary<long, string> _newAliases = [];
    private PersistingComponentStateSubscription? _persistSubscription;

    protected override async Task OnInitializedAsync()
    {
        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistState);

        if (ApplicationState.TryTakeFromJson<IReadOnlyList<ProductQualifier>>("admin-qualifiers", out var qualifiers) && qualifiers != null
            && ApplicationState.TryTakeFromJson<IReadOnlyList<UnmatchedQualifierName>>("admin-qualifiers-unmatched", out var unmatched) && unmatched != null)
        {
            _qualifiers = qualifiers;
            _unmatched = unmatched;
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private Task PersistState()
    {
        if (_unmatched != null)
        {
            ApplicationState.PersistAsJson("admin-qualifiers", _qualifiers);
            ApplicationState.PersistAsJson("admin-qualifiers-unmatched", _unmatched);
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _persistSubscription?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _pendingDelete = null;

        try
        {
            _qualifiers = await Api.GetQualifiersAsync();
            _unmatched = await Api.GetUnmatchedQualifierNamesAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Failed to load plans and surfaces: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string AliasKey(UnmatchedQualifierName name) => $"{name.Kind}:{name.Name}";

    private string GetAliasTarget(UnmatchedQualifierName name) => _aliasTargets.TryGetValue(AliasKey(name), out var target) ? target : string.Empty;

    private void SetAliasTarget(UnmatchedQualifierName name, string? target) => _aliasTargets[AliasKey(name)] = target ?? string.Empty;

    private string GetRename(ProductQualifier qualifier) => _renames.TryGetValue(qualifier.Id, out var name) ? name : qualifier.Name;

    private void SetRename(ProductQualifier qualifier, string? name) => _renames[qualifier.Id] = name ?? string.Empty;

    private string GetNewAlias(ProductQualifier qualifier) => _newAliases.TryGetValue(qualifier.Id, out var alias) ? alias : string.Empty;

    private void SetNewAlias(ProductQualifier qualifier, string? alias) => _newAliases[qualifier.Id] = alias ?? string.Empty;

    private async Task CreateAsync()
    {
        if (await RunAsync(() => Api.CreateQualifierAsync(_newKind, _newName), $"'{_newName.Trim()}' added."))
        {
            _newName = string.Empty;
        }
    }

    private Task AddAsync(string kind, string name) =>
        RunAsync(() => Api.CreateQualifierAsync(kind, name), $"'{name}' added as {kind}.");

    private Task AddAsAliasAsync(UnmatchedQualifierName name)
    {
        var targetName = GetAliasTarget(name).Trim();
        var target = _qualifiers.FirstOrDefault(q => q.Kind == name.Kind && string.Equals(q.Name, targetName, StringComparison.OrdinalIgnoreCase));
        if (target is null)
        {
            _message = $"'{targetName}' is not a {name.Kind}. Pick one from the list.";
            _messageIsError = true;
            return Task.CompletedTask;
        }

        return RunAsync(() => Api.AddQualifierAliasAsync(target.Id, name.Name), $"'{name.Name}' is now an alias of '{target.Name}'.");
    }

    private Task RenameAsync(ProductQualifier qualifier) =>
        RunAsync(() => Api.RenameQualifierAsync(qualifier.Id, GetRename(qualifier)), $"Renamed to '{GetRename(qualifier).Trim()}'.");

    private async Task AddAliasAsync(ProductQualifier qualifier)
    {
        var alias = GetNewAlias(qualifier).Trim();
        if (await RunAsync(() => Api.AddQualifierAliasAsync(qualifier.Id, alias), $"Alias '{alias}' added to '{qualifier.Name}'."))
        {
            _newAliases.Remove(qualifier.Id);
        }
    }

    private Task RemoveAliasAsync(ProductQualifier qualifier, QualifierAlias alias) =>
        RunAsync(() => Api.RemoveQualifierAliasAsync(qualifier.Id, alias.Id), $"Alias '{alias.Alias}' removed from '{qualifier.Name}'.");

    private Task DeleteAsync(ProductQualifier qualifier) =>
        RunAsync(() => Api.DeleteQualifierAsync(qualifier.Id), $"'{qualifier.Name}' deleted.");

    private async Task<bool> RunAsync(Func<Task> change, string successMessage)
    {
        _busy = true;
        _message = null;

        try
        {
            await change();
            _message = successMessage;
            _messageIsError = false;
            _renames.Clear();
            await LoadAsync();
            return true;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (HttpRequestException ex)
        {
            _message = ex.Message;
            _messageIsError = true;
            return false;
        }
        finally
        {
            _busy = false;
        }
    }
}
