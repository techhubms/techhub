@page "/admin/reviews"
@layout AdminLayout
@rendermode InteractiveServer
@inherits PageComponentBase

<PageTitle>Reviews — TechHub Admin</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Reviews</h1>
            <p class="admin-page-subtitle">Everything that needs your decision, in one place</p>
        </div>
        <div class="admin-actions">
            <AdminSubbarAction><button class="btn-secondary" @onclick="RefreshAsync">⟳ Refresh</button></AdminSubbarAction>
        </div>
    </div>

    <ReviewOverview @ref="_overview" />

    <ContentFixReviews @ref="_contentFixes" />
</div>

@code {
    private ReviewOverview? _overview;
    private ContentFixReviews? _contentFixes;

    private async Task RefreshAsync()
    {
        if (_overview is not null)
        {
            await _overview.RefreshAsync();
        }

        if (_contentFixes is not null)
        {
            await _contentFixes.RefreshAsync();
        }
    }
}
