@page "/admin/newsletter/send-log"
@layout AdminLayout
@rendermode InteractiveServer
@using TechHub.Core.Models.Admin
@using TechHub.Web.Services
@inject ITechHubApiClient Api
@inject ILogger<AdminNewsletterSendLog> Logger
@inherits PageComponentBase

<PageTitle>Newsletter send log — TechHub Admin</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Send log</h1>
            <p class="admin-page-subtitle">The last 100 newsletter sends and how many recipients they reached</p>
        </div>
        <div class="admin-actions">
            <AdminSubbarAction><button class="btn-secondary" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Refreshing…" : "⟳ Refresh")</button></AdminSubbarAction>
        </div>
    </div>

    @if (_error != null)
    {
        <div class="admin-alert admin-alert-error" role="alert">@_error</div>
    }

    @if (!_loading && _error == null && _sendLog.Count == 0)
    {
        <div class="admin-empty">Nothing has been sent yet.</div>
    }
    else
    {
        <div class="admin-jobs-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Kind</th>
                        <th>Target</th>
                        <th>Sent</th>
                        <th>Failed</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _sendLog)
                    {
                        <tr>
                            <td class="admin-cell-mono">@DateHelper.FormatTimestamp(log.SentAt)</td>
                            <td>@log.SendKind</td>
                            <td class="admin-cell-mono">@log.TargetKey</td>
                            <td>@log.RecipientCount</td>
                            <td>@(log.FailedCount > 0 ? log.FailedCount.ToString() : "—")</td>
                            <td>@log.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<NewsletterSendLogEntry> _sendLog = [];
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _sendLog = await Api.GetNewsletterSendLogAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Failed to load the newsletter send log");
            _error = "Failed to load the send log.";
        }
        finally
        {
            _loading = false;
        }
    }
}
