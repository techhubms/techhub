{
	"mcpServers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"tools": [
				"*"
			],
			"headers": {
				"CONTEXT7_API_KEY": ""
			}
		},
		"playwright": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest",
				"--vision",
				"--headless",
				"--isolated",
				"--no-sandbox",
				"--config",
				"/workspaces/techhub/.vscode/playwright-mcp-config.json"
			],
			"tools": [
				"*"
			]
		},
		"techhub": {
			"type": "http",
			"url": "https://tech.hub.ms/mcp",
			"tools": [
				"*"
			]
		}
	}
}
